# Copy to terraform.tfvars (git-ignored) or pass with -var / TF_VAR_ env vars.

aws_region  = "ap-south-1"
project     = "devops-assignment"
owner       = "platform-team"
environment = "prod"

instance_type    = "t3.micro"
min_size         = 2
max_size         = 4
desired_capacity = 2

app_version        = "1.0.0"
log_retention_days = 30

# Confirm the subscription email AWS sends to this address.
alarm_email = "you@example.com"
